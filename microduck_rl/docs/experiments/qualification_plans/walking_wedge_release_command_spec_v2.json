{
  "spec_id": "walking-wedge-production-release-commands-v2",
  "commands": [
    {
      "stage": "release_scope_retention",
      "argv": [
        "uv", "run", "--no-sync", "eggroll-autopatch", "qualify-release-stage",
        "--stage", "release_scope_retention",
        "--candidate-checkpoint", "{candidate_checkpoint}",
        "--checkpoint-sha256", "{checkpoint_sha256}",
        "--generation", "{generation}",
        "--evidence-directory", "{evidence_directory}",
        "--result-path", "{result_path}",
        "--campaign", ".artifacts/input/campaign.json",
        "--release-scope", ".artifacts/input/release_scope.json",
        "--runtime-repo", "/work/microduck"
      ],
      "result_path": "generation-{generation}/release_scope_retention.json",
      "timeout_seconds": 120.0,
      "execution_failure_action": "abort_campaign"
    },
